# Настройки базы данных
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=url_shortener_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Строка подключения для SQLAlchemy (асинхронный драйвер asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/url_shortener_db

# Настройки приложения
APP_HOST=0.0.0.0
APP_PORT=8000
BASE_URL=http://localhost:8000
